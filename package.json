{
  "name": "tree-register",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 11向け DCATカタログ登録設定アプリ",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:electron": "node scripts/smoke.mjs",
    "package": "tsc -p tsconfig.electron.json && vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "jp.tree-register.desktop",
    "productName": "Tree Register",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
